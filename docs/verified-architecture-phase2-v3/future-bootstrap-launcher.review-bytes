# CANDIDATE REVIEW INPUT ONLY. NO SHEBANG. DO NOT EXECUTE WITHOUT OWNER APPROVAL AND GO.
set -euf
fail() { /usr/bin/printf '%s\n' "$1" >&2; exit 96; }
[ "$#" -eq 4 ] || fail E_LAUNCH_ARGUMENTS
ROOT=$1
SCRIPT=$2
INPUT=$3
OUTPUT=$4
[ "$ROOT" = /reviewed-root ] || fail E_ROOT
[ "$SCRIPT" = /reviewed-root/docs/verified-architecture-phase2-v3/future-rust-provisioning-script.review-bytes ] || fail E_SCRIPT_PATH
[ -f "$SCRIPT" ] && [ ! -L "$SCRIPT" ] || fail E_SCRIPT_TYPE
actual=$(/usr/bin/sha256sum "$SCRIPT") || fail E_SCRIPT_HASH_TOOL
[ "${actual%% *}" = 7d6b7c6399919ebfc4c9f3eea4455b5033ec6ed0a57ffed570ecfe525fde9b33 ] || fail E_SCRIPT_DIGEST
[ "$(/usr/bin/stat -c %s "$SCRIPT")" = 8738 ] || fail E_SCRIPT_LENGTH
[ "$(/usr/bin/stat -c %a "$SCRIPT")" = 644 ] || fail E_SCRIPT_MODE
exec /usr/bin/bash --noprofile --norc "$SCRIPT" "$INPUT" "$OUTPUT"
