{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "School Physical ScenePackage V2",
  "type": "object",
  "required": [
    "scenePackageVersion",
    "scenePackageId",
    "scenePackageDigest",
    "sceneRef",
    "refs",
    "entities",
    "supportRelations",
    "requiredEntityIds",
    "provenanceLedger"
  ],
  "properties": {
    "scenePackageVersion": {
      "const": "2.0.0"
    },
    "scenePackageId": {
      "const": "SCHOOL_TREATMENT_ROOM_PHYSICAL_V2"
    },
    "scenePackageDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "entities": {
      "type": "array",
      "minItems": 3
    },
    "supportRelations": {
      "type": "array",
      "minItems": 3
    }
  },
  "additionalProperties": true
}
